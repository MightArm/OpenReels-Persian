# OpenReels API Keys
# Copy this file to .env and fill in your keys
#
# Docker: docker run --env-file .env --shm-size=2gb -v ./output:/output openreels "your topic"
# Local:  pnpm start "your topic"

# Required: LLM provider (at least one)
# Anthropic (default): https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI (--provider openai): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required: Text-to-Speech (at least one)
# ElevenLabs (default): https://elevenlabs.io/
ELEVENLABS_API_KEY=
# Inworld (--tts-provider inworld): https://inworld.ai/
INWORLD_TTS_API_KEY=
# Alpha (--tts-provider alpha): https://api.appalpha.ir/ (create keys in the dashboard)
ALPHA_API_KEY=
# Optional Alpha voice override (default: shahab; see https://api.appalpha.ir/docs#voices)
# ALPHA_TTS_SPEAKER=mahtab
# Optional fixed Alpha delivery instruction (Alpha's `tone` field, never read aloud)
# ALPHA_TTS_TONE=calm and reassuring, like a late-night news anchor

# Required: AI Image Generation (at least one)
# Gemini (default): https://aistudio.google.com/apikey
# OpenAI GPT Image (--image-provider openai): uses OPENAI_API_KEY above
GOOGLE_API_KEY=

# Optional: OpenRouter (--provider openrouter): https://openrouter.ai/
OPENROUTER_API_KEY=

# Optional: OmniRoute (--provider omniroute / --image-provider omniroute)
# Free AI gateway: 352+ providers behind one OpenAI-compatible endpoint.
# Run locally first: npx omniroute@latest (or docker run -p 20128:20128 diegosouzapw/omniroute)
# Create an API key in the dashboard at http://localhost:20128
OMNIROUTE_API_KEY=
# Optional: override the OmniRoute endpoint (default: http://localhost:20128/v1)
# OMNIROUTE_BASE_URL=http://localhost:20128/v1
# Optional: override the image model used by --image-provider omniroute.
# Any image-capable model ID from GET /v1/models works (see http://localhost:20128).
# OMNIROUTE_IMAGE_MODEL=aihorde/stable_diffusion

# Optional: Tavily web search (--search-provider tavily): https://tavily.com/
# Required when using OpenRouter/OpenAI-compatible providers for web research
TAVILY_API_KEY=

# Optional: OpenAI-compatible endpoint (--provider openai-compatible)
# OPENREELS_LLM_BASE_URL=http://localhost:11434/v1
# OPENREELS_LLM_MODEL=llama3:8b
# OPENREELS_LLM_API_KEY=

# Optional: Stock footage (free, but requires registration)
# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Stock Only mode: use only cost-free stock media; never call AI image/video providers
# STOCK_ONLY=false

# TTS narration language: english (default) or farsi (Director writes the narration in Persian)
TTS_LANGUAGE=farsi
